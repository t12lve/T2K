{
  "manifest_version": 3,
  "name": "T2K",
  "version": "3.0.0",
  "description": "Twitch To Kick — le streamer colle une phrase, les viewers suivent vers Kick",
  "action": {
    "default_title": "T2K — phrase raid",
    "default_popup": "popup.html"
  },
  "host_permissions": ["https://www.twitch.tv/*"],
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["phrases.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
