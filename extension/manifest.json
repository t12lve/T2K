{
  "manifest_version": 3,
  "name": "T2K",
  "version": "1.0.0",
  "description": "Twitch To Kick — signed cross-platform raid redirects",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://*.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
