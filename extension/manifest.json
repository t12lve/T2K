{
  "manifest_version": 3,
  "name": "T2K",
  "version": "3.1.0",
  "description": "Twitch To Kick — phrase discrète, source→cible et timer réglables",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "T2K",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.twitch.tv/*"],
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["phrases.js", "settings.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
